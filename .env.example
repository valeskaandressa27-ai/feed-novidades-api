# Banco (lido pelo docker compose). Copie para .env se quiser mudar algo.
POSTGRES_DB=feed_novidades
POSTGRES_USER=feed
POSTGRES_PASSWORD=feed
POSTGRES_PORT=5432

# Aplicação (o Spring NÃO lê o .env; exporte estas variáveis no terminal
# apenas se mudou os valores acima. Os padrões já batem com o compose.)
DB_URL=jdbc:postgresql://localhost:5432/feed_novidades
DB_USER=feed
DB_PASSWORD=feed
